---
import SectionHeading from './SectionHeading.astro';
import TextLink from './TextLink.astro';
import ContactSuccessDialog from './ContactSuccessDialog.astro';
import { links } from '../data/links';
import { translate, withBase } from '../data/site';
import type { Locale } from '../data/types';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = translate(lang);
---
<section class="page-section access-section" id="access">
  <SectionHeading lang={lang} number="05" en="Access & contact" ja="アクセス・お問い合わせ" />
  <div class="campus-layout">
    <div class="campus-map">
      <iframe src={links.googleEmbed} title={t('慶應義塾大学 湘南藤沢キャンパスのGoogleマップ', 'Google Map of Keio University Shonan Fujisawa Campus')} width="600" height="360" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      <TextLink href={links.googleMap} external cmsHref="mapUrl">{t('Googleマップで開く', 'Open in Google Maps')}</TextLink>
    </div>
    <div class="access-copy">
      <p class="eyebrow">Shonan Fujisawa Campus</p>
      <h3>{t('慶應義塾大学', 'Keio University')}<br />{t('湘南藤沢キャンパス', 'Shonan Fujisawa Campus')}</h3>
      <address data-cms-field="address">{t('〒252-0882', '5322 Endo, Fujisawa, Kanagawa')}<br />{t('神奈川県藤沢市遠藤5322', '252-0882, Japan')}</address>
      <p data-cms-field="access">{t('湘南台駅西口、または辻堂駅北口より', 'Take a bus bound for Keio University from the west exit of Shonandai Station or the north exit of Tsujido Station.')}{lang === 'ja' && <><br />「慶応大学」行きバスをご利用ください。</>}</p>
      <div class="access-links">
        <TextLink href={links.campus} external cmsHref="campusUrl">{t('交通アクセス（大学公式）', 'Directions (Keio University)')}</TextLink>
        <TextLink href={links.campusMap} external>{t('キャンパスマップ', 'Campus map')}</TextLink>
      </div>
      <p class="section-note">{t('研究室への訪問は、事前のご相談をお願いします。', 'Please arrange your visit in advance.')}</p>
    </div>
  </div>
  <div class="contact-block" id="contact">
    <div><p class="eyebrow">Get in touch</p><h3>{t('お問い合わせ', 'Contact')}</h3><p>{t('共同研究・交流・取材、研究会への参加・履修のご相談。', 'For collaboration, exchange, media inquiries, and student participation.')}</p></div>
    <div class="contact-action">
      <iframe class="contact-widget" src={`${withBase('contact-form.html')}?lang=${lang}`} title={t('お問い合わせフォーム', 'Inquiry form')} loading="lazy"></iframe>
    </div>
  </div>
  <ContactSuccessDialog lang={lang} />
</section>
