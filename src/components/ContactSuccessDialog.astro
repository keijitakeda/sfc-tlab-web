---
import { translate } from '../data/site';
import type { Locale } from '../data/types';
interface Props { lang: Locale; }
const t = translate(Astro.props.lang);
---
<dialog class="contact-success" aria-labelledby="contact-success-title">
  <span class="contact-success-symbol" aria-hidden="true">✓</span>
  <h2 id="contact-success-title">{t('お問い合わせを送信しました', 'Inquiry sent')}</h2>
  <p>{t('お問い合わせありがとうございます。', 'Thank you for contacting us.')}</p>
  <button class="contact-success-close" type="button">{t('閉じる', 'Close')}</button>
</dialog>
<script>
  const contactFrame = document.querySelector<HTMLIFrameElement>('.contact-widget');
  const successDialog = document.querySelector<HTMLDialogElement>('.contact-success');
  const closeButton = successDialog?.querySelector<HTMLButtonElement>('.contact-success-close');
  closeButton?.addEventListener('click', () => successDialog?.close());
  window.addEventListener('message', (event: MessageEvent) => {
    if (event.origin !== window.location.origin || event.source !== contactFrame?.contentWindow) return;
    if (event.data?.type !== 'takeda-contact:submitted' || !successDialog) return;
    successDialog.showModal();
    closeButton?.focus();
  });
</script>
<style>
  .contact-success{width:min(450px,calc(100% - 32px));border:1px solid #d6e1d9;border-radius:2px;box-shadow:0 18px 70px #183c2d2b;padding:32px 34px;color:#26362f;text-align:center;background:#fff}
  .contact-success::backdrop{background:#15251db3}
  .contact-success-symbol{display:grid;place-items:center;width:44px;height:44px;margin:0 auto 19px;border:1px solid #548370;border-radius:50%;color:#315d53;font-size:25px}
  .contact-success h2{font-size:22px;font-weight:500;margin:0 0 12px}
  .contact-success p{font-size:13px;line-height:1.8;color:#5a6d63;margin:0 0 24px}
  .contact-success-close{min-width:150px;min-height:46px;background:#315d53;border:0;color:#fff;font-size:13px;cursor:pointer}
  .contact-success-close:focus-visible{outline:3px solid #315d53;outline-offset:3px}
  @media(max-width:620px){.contact-success{padding:27px 22px}}
</style>
